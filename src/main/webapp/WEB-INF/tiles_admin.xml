        <put-attribute name="sidebar" value="/WEB-INF/views/inc/admin_sidebar.jsp" /> 
    </definition>
    
    <definition name="admin/*" extends="admin.layout">
        <put-attribute name="title" value="관리자 페이지" /> <put-attribute name="content" value="/WEB-INF/views/content/admin/{1}.jsp"/>
